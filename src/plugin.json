{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/master/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Checkmk data source",
  "id": "checkmk-cloud-datasource",
  "metrics": true,
  "info": {
    "description": "Checkmk data source for Checkmk 2.3.0 or higher",
    "author": {
      "name": "Checkmk GmbH",
      "url": "https://github.com/Checkmk/"
    },
    "keywords": ["checkmk"],
    "logos": {
      "small": "img/checkmk_logo.svg",
      "large": "img/checkmk_logo.svg"
    },
    "links": [
      {
        "name": "Documentation",
        "url": "https://docs.checkmk.com/latest/en/grafana.html"
      },
      {
        "name": "GitHub",
        "url": "https://github.com/Checkmk/grafana-checkmk-datasource"
      },
      {
        "name": "Checkmk",
        "url": "https://Checkmk.com"
      }
    ],
    "screenshots": [
      {
        "name": "Checkmk metrics shown in Grafana",
        "path": "img/screenshot.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=10.4.18",
    "plugins": []
  },
  "routes": [
    {
      "path": "rest/check_mk/api/1.0/version",
      "method": "GET",
      "url": "{{ .JsonData.url }}/check_mk/api/1.0/version",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .JsonData.username }} {{ .SecureJsonData.secret }}"
        }
      ]
    },
    {
      "path": "rest/check_mk/api/1.0/domain-types/host/collections/all",
      "method": "GET",
      "url": "{{ .JsonData.url }}/check_mk/api/1.0/domain-types/host/collections/all",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .JsonData.username }} {{ .SecureJsonData.secret }}"
        }
      ]
    },
    {
      "path": "rest/check_mk/api/1.0/domain-types/service/collections/all",
      "method": "GET",
      "url": "{{ .JsonData.url }}/check_mk/api/1.0/domain-types/service/collections/all",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .JsonData.username }} {{ .SecureJsonData.secret }}"
        }
      ]
    },
    {
      "path": "rest/check_mk/api/1.0/domain-types/metric/actions/get/invoke",
      "method": "POST",
      "url": "{{ .JsonData.url }}/check_mk/api/1.0/domain-types/metric/actions/get/invoke",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .JsonData.username }} {{ .SecureJsonData.secret }}"
        }
      ]
    },
    {
      "path": "rest/check_mk/api/1.0/domain-types/metric/actions/filter/invoke",
      "method": "POST",
      "url": "{{ .JsonData.url }}/check_mk/api/1.0/domain-types/metric/actions/filter/invoke",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .JsonData.username }} {{ .SecureJsonData.secret }}"
        }
      ]
    },
    {
      "path": "rest/check_mk/api/1.0/objects/autocomplete/",
      "method": "POST",
      "url": "{{ .JsonData.url }}/check_mk/api/1.0/objects/autocomplete/",
      "headers": [
        {
          "name": "Authorization",
          "content": "Bearer {{ .JsonData.username }} {{ .SecureJsonData.secret }}"
        }
      ]
    }
  ]
}
